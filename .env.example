DATABASE_URL="file:./dev.db"

# Вход через Google (Auth.js). Сгенерировать: openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Redirect URI: <адрес сайта>/api/auth/callback/google (локально http://localhost:3000/api/auth/callback/google).
# Пока ключи не заданы — вход выключен, всё работает по секретной ссылке редактора.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Локально — Postgres из docker-compose.yml. На Vercel — строки Supabase (Connect → ORM → Prisma):
# DATABASE_URL через пулер (порт 6543, ?pgbouncer=true), DIRECT_URL — прямое подключение для миграций (порт 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/wedding"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/wedding"

# Вход через Google (Auth.js). Сгенерировать: openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Redirect URI: <адрес сайта>/api/auth/callback/google (локально http://localhost:3000/api/auth/callback/google).
# Пока ключи не заданы — вход выключен, всё работает по секретной ссылке редактора.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# "true" — ссылка для гостей, «Открыть» и ответы гостей только владельцу по аккаунту.
# Пусто — вход доступен, но не обязателен: всё работает по секретной ссылке редактора (удобно тестировать на телефоне).
AUTH_REQUIRED=""

# Хранилище фото — Supabase Storage (только на проде/Vercel). Без них фото пишутся в public/uploads.
# SUPABASE_URL — https://<id проекта>.supabase.co; ключ — Project Settings → API Keys → Secret key (никогда не NEXT_PUBLIC_).
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Скрытый показ шаблонов /showcase/<ключ> и съёмка видео (npm run video). Не задан — страниц нет (404).
# Длинная случайная строка (≥ 16 символов): openssl rand -hex 16
SHOWCASE_KEY=""

# Скрытая админка /admin/<ключ>: правка шаблонов, запись и просмотр видео. Только локально (на Vercel её нет).
# Запись видео идёт через показ — нужен и SHOWCASE_KEY. openssl rand -hex 16
ADMIN_KEY=""

# Адрес сайта для превью ссылок (og:image, og:url), например https://keleber.kg. Пусто — берётся хост запроса.
SITE_URL=""
